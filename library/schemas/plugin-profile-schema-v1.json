{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:silemio:plugin-profile:v1",
  "title": "SiLeMI/O Plugin Profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_version",
    "id",
    "status",
    "layer",
    "plugin_name",
    "identity",
    "parameters"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "profile_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "status": {"enum": ["builtin", "verified", "community", "local"]},
    "layer": {"enum": ["suggested", "user"]},
    "plugin_name": {"type": "string", "minLength": 1},
    "manufacturer": {"type": "string"},
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "stable_id", "parameter_fingerprint"],
      "properties": {
        "format": {"type": "string", "minLength": 1},
        "stable_id": {"type": "string", "minLength": 1},
        "parameter_fingerprint": {
          "type": "string",
          "pattern": "^[0-9A-Fa-f]{64}$"
        },
        "version": {"type": "string", "minLength": 1}
      }
    },
    "parameters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stable_id", "name"],
        "properties": {
          "stable_id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "short_label": {"type": "string", "minLength": 1, "maxLength": 16},
          "unit": {"type": "string"},
          "role": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "kind": {"enum": ["continuous", "toggle", "enum", "meter"]},
          "importance": {"type": "integer", "minimum": 0, "maximum": 100},
          "enabled": {"type": "boolean", "default": true}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"layer": {"const": "user"}}},
      "then": {"properties": {"status": {"const": "local"}}}
    },
    {
      "if": {"properties": {"layer": {"const": "suggested"}}},
      "then": {
        "properties": {
          "status": {"enum": ["builtin", "verified", "community"]}
        }
      }
    }
  ]
}
